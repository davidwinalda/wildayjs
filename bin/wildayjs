#!/usr/bin/env node
const fs = require("fs").promises;
const { showHelp, errors } = require("../lib/utils/chalkUtils");
const ModelGenerator = require("../lib/models/modelGenerator");
const ControllerGenerator = require("../lib/controllers/controllerGenerator");

const listDatabases = require("../lib/database/lists");
const {
  initDatabase,
  switchDatabase,
  DATABASE_TYPES,
} = require("../lib/database/init");
const dbStatus = require("../lib/database/status");
const checkDatabase = require("../lib/database/check");

const { startConsole, newApp } = require("../index");
const { program } = require("commander");
const path = require("path");

// Add Knex migration system
const {
  KnexMigrationSystem,
  COLUMN_TYPES,
  createMigration,
  runMigrations,
  rollbackMigrations,
  getMigrationStatus,
  runSingleMigration,
  rollbackSingleMigration,
  redoMigration,
  getCurrentVersion,
  resetMigrations,
  MigrationGenerator,
  createSeed,
  createTableWithSeed,
  createHasOneWithSeed,
  addColumnWithSeed,
  runSeeds,
  SeedGenerator,
} = require("../lib/knex-migrations");
const { log } = require("../lib/knex-migrations/utils/logger");
const knexManager = require("../lib/knex-migrations/knexManager");

// Read version from package.json
const packageJson = require(path.join(__dirname, "..", "package.json"));

program
  .version(packageJson.version)
  .description("WildayJS - A Full-Stack JavaScript Web Framework");

// New app command
program
  .command("new <app-name>")
  .description("Create a new WildayJS application")
  .action((appName) => {
    if (!appName) {
      errors.missingArgument("app name");
      process.exit(1);
    }
    newApp(appName);
  });

// Database commands
program
  .command("db:init")
  .description("Initialize multi-database configuration")
  .option(
    "-t, --type <type>",
    `Set active database type (${DATABASE_TYPES.join("|")})`,
    "sqlite"
  )
  .option("-f, --force", "Force overwrite existing configuration", false)
  .action((options) => {
    const { type, force } = options;

    if (!DATABASE_TYPES.includes(type)) {
      console.error(`Error: Invalid database type '${type}'`);
      console.log(`Supported types: ${DATABASE_TYPES.join(", ")}`);
      process.exit(1);
    }

    console.log("\nInitializing multi-database configuration with options:", {
      activeType: type,
      force,
    });

    initDatabase({ type, force }).catch((error) => {
      console.error("Database initialization failed:", error.message);
      process.exit(1);
    });
  });

program
  .command("db:switch")
  .description("Switch active database")
  .argument(
    "<type>",
    `Database type to switch to (${DATABASE_TYPES.join("|")})`
  )
  .action((newType) => {
    if (!DATABASE_TYPES.includes(newType)) {
      console.error(`Error: Invalid database type '${newType}'`);
      console.log(`Supported types: ${DATABASE_TYPES.join(", ")}`);
      process.exit(1);
    }

    console.log(`\nSwitching active database to: ${newType}`);

    switchDatabase(newType)
      .then(() => {
        console.log(`Successfully switched to ${newType} database`);
      })
      .catch((error) => {
        console.error("Failed to switch database:", error.message);
        process.exit(1);
      });
  });

program
  .command("db:status:old")
  .description("Show database migration status and configuration")
  .option(
    "-t, --type <type>",
    `Check specific database type (${DATABASE_TYPES.join("|")})`,
    null
  )
  .action((options) => {
    if (options.type && !DATABASE_TYPES.includes(options.type)) {
      console.error(`Error: Invalid database type '${options.type}'`);
      console.log(`Supported types: ${DATABASE_TYPES.join(", ")}`);
      process.exit(1);
    }
    dbStatus(options.type);
  });

program
  .command("db:check")
  .description("Check database connection and structure")
  .option(
    "-t, --type <type>",
    `Check specific database type (${DATABASE_TYPES.join("|")})`,
    null
  )
  .action((options) => {
    if (options.type && !DATABASE_TYPES.includes(options.type)) {
      console.error(`Error: Invalid database type '${options.type}'`);
      console.log(`Supported types: ${DATABASE_TYPES.join(", ")}`);
      process.exit(1);
    }
    checkDatabase(options.type);
  });

program
  .command("db:list")
  .description("List all configured databases and their status")
  .action(listDatabases);

// Generate commands
program
  .command("generate:controller <name> [actions...]")
  .description("Generate a new controller")
  .option("--api", "Generate an API controller")
  .option("--skip-views", "Skip generating views")
  .option("--skip-routes", "Skip adding routes")
  .action((name, actions, options) => {
    if (!name) {
      console.error("Controller name is required");
      process.exit(1);
    }
    const generator = new ControllerGenerator(name, actions, options);
    generator.generate();
  });

program
  .command("generate:model <name> [attributes...]")
  .description("Generate a new model")
  .action((name, attributes) => {
    if (!name) {
      console.error("Model name is required");
      process.exit(1);
    }
    const generator = new ModelGenerator(name, attributes);
    generator.generate();
  });

// Update the migration generation command
program
  .command("generate:migration <name> [columns...]")
  .description("Generate a new migration file")
  .option("-c, --columns <items>", "Column definitions (comma-separated)")
  .option("-t, --table <name>", "Table name for the migration")
  .option("-s, --soft-deletes", "Add soft deletes column")
  .option("--timestamps", "Add timestamp columns", true)
  .option("--from <column>", "Original column name for rename migrations")
  .option("--to <column>", "New column name for rename migrations")
  .action(async (name, columnArgs, options) => {
    try {
      if (!name) {
        errors.migrationNameRequired();
        process.exit(1);
      }

      // Parse columns from both arguments and options
      let columns = [];
      let tableName;

      // Handle direct column arguments (Rails style)
      if (columnArgs && columnArgs.length > 0) {
        // Extract table name from columns if present
        const tableNameArg = columnArgs.find((col) =>
          col.startsWith("tableName:")
        );
        if (tableNameArg) {
          tableName = tableNameArg.split(":")[1];
          // Remove tableName from columns
          columns = columnArgs.filter((col) => col !== tableNameArg);
          console.log("[DEBUG] Extracted table name:", tableName);
        } else {
          columns = columnArgs;
        }
      }
      // Handle --columns option (legacy style)
      else if (options.columns) {
        columns = options.columns.split(",").map((col) => col.trim());
      }

      const migrationOptions = {
        tableName: tableName || options.table,
        softDeletes: options.softDeletes,
        timestamps: options.timestamps,
      };

      console.log("[DEBUG] Migration options:", migrationOptions);
      const filepath = await createMigration(name, columns, migrationOptions);
      // log.success(`Created migration: ${filepath}`);
    } catch (error) {
      log.error("Failed to create migration:", error.message);
      process.exit(1);
    }
  })
  .addHelpText(
    "after",
    `
Examples:
  # Create table
  $ wildayjs generate:migration CreateUsers name:string:required email:string:unique

  # Add column
  $ wildayjs generate:migration AddPhoneToUsers phone:string:index

  # Remove column (simple)
  $ wildayjs generate:migration RemovePhoneFromUsers

  # Remove column with type and constraints (for proper rollback)
  $ wildayjs generate:migration RemovePhoneFromUsers phone:string:required:unique:index

  # Remove multiple columns
  $ wildayjs generate:migration RemoveDetailsFromUsers phone:string:required age:integer bio:text

  # Remove columns (using --columns option)
  $ wildayjs generate:migration RemoveDetailsFromUsers -c "phone:string:required,age:integer,bio:text"

  # Rename column
  $ wildayjs generate:migration RenamePhoneToMobileInUsers

  # Change column
  $ wildayjs generate:migration ChangeEmailInUsers -c "email:string:required:unique"

  # Drop table
  $ wildayjs generate:migration DropUsers

  # Create join table with custom name
  $ wildayjs generate:migration CreateJoinTablePostsAndCategories tableName:categorization

  # Create join table with custom name and additional columns
  $ wildayjs generate:migration CreateJoinTablePostsAndCategories tableName:categorization position:integer

  # Create join table with default name (posts_categories)
  $ wildayjs generate:migration CreateJoinTablePostsAndCategories

  # Legacy style (still supported)
  $ wildayjs generate:migration create_users -c "name:string:required,email:string:unique" -s
  `
  );

// Remove the old migration commands and keep only the new ones
program
  .command("db:migrate")
  .description("Run pending migrations")
  .option("--dry-run", "Show which migrations would run without executing them")
  .action(async (options) => {
    try {
      if (options.dryRun) {
        const status = await getMigrationStatus();
        if (status.pending.length === 0) {
          log.info("No pending migrations");
          return;
        }
        log.info("Pending migrations:");
        status.pending.forEach((migration) => log.info(`- ${migration}`));
        return;
      }

      const result = await runMigrations();
      log.success(`Executed ${result.executed} migrations`);
    } catch (error) {
      log.error("Migration failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:rollback")
  .description("Rollback migrations")
  .option("-a, --all", "Rollback all migrations")
  .option("-s, --steps <number>", "Number of migrations to rollback", "1")
  .action(async (options) => {
    try {
      const result = await rollbackMigrations({
        all: options.all,
        steps: parseInt(options.steps, 10),
      });
    } catch (error) {
      log.error("Rollback failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:up [name]")
  .description("Run a specific migration")
  .action(async (name) => {
    try {
      await runSingleMigration(name);
      log.success(`Successfully ran migration: ${name}`);
    } catch (error) {
      log.error("Migration failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:down [name]")
  .description("Rollback a specific migration")
  .action(async (name) => {
    try {
      await rollbackSingleMigration(name);
      log.success(`Successfully rolled back migration: ${name}`);
    } catch (error) {
      log.error("Rollback failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:redo [name]")
  .description("Redo migrations (rollback and migrate again)")
  .action(async (name) => {
    try {
      await redoMigration(name);
    } catch (error) {
      log.error("Redo failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:migration:status")
  .description("Show migration status")
  .action(async () => {
    try {
      const status = await getMigrationStatus();
      log.info("\nMigration Status:");
      log.info(`- Completed: ${status.completed.length}`);
      log.info(`- Pending: ${status.pending.length}`);
      log.info(`- Total: ${status.total}`);

      if (status.pending.length > 0) {
        log.info("\nPending Migrations:");
        status.pending.forEach((migration) => log.info(`- ${migration}`));
      }
    } catch (error) {
      log.error("Failed to get migration status:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:reset")
  .description("Reset database by running all migrations down and up")
  .option("--force", "Skip confirmation prompt")
  .action(async (options) => {
    try {
      await resetMigrations(options);
    } catch (error) {
      log.error("Reset failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:status")
  .description("Show migration status")
  .action(async () => {
    try {
      await getMigrationStatus();
    } catch (error) {
      log.error("Failed to get migration status:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:version")
  .description("Show current migration version")
  .action(async () => {
    try {
      await getCurrentVersion();
    } catch (error) {
      log.error("Failed to get version:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

// Seed commands
program
  .command("generate:seed <name>")
  .description("Generate a standalone seed file")
  .option("-t, --table <table>", "Table name for the seed")
  .option("-d, --data <json>", "JSON string of seed data")
  .action(async (name, options) => {
    try {
      await createSeed(name, options);
    } catch (error) {
      log.error("Failed to create seed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  })
  .addHelpText(
    "after",
    `
Examples:
  # Generate basic seed file
  $ wildayjs generate:seed CreateUsers --table=users

  # Generate with data
  $ wildayjs generate:seed CreateUsers --table=users --data='[
    {
      "email": "john@example.com",
      "username": "john_doe",
      "password": "password123",
      "full_name": "John Doe"
    }
  ]'
`
  );

program
  .command("db:seed")
  .description("Run database seeds")
  .option("-f, --file <name>", "Run specific seed file")
  .option("--dry-run", "Show which seeds would run without executing them")
  .action(async (options) => {
    try {
      if (options.dryRun) {
        const knex = knexManager.getInstance();
        const seeds = await knex.seed.list();
        if (seeds.length === 0) {
          log.info("No seed files found");
          return;
        }
        log.info("\nAvailable seed files:");
        seeds.forEach((file) => log.info(`- ${path.basename(file)}`));
        return;
      }

      await runSeeds(options);
      log.success("Successfully ran seeds");
    } catch (error) {
      log.error("Failed to run seeds:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  })
  .addHelpText(
    "after",
    `
Examples:
  # Run all seed files
  $ wildayjs db:seed

  # Run specific seed file
  $ wildayjs db:seed --file=20240120_create_users.js

  # Show available seeds without running them
  $ wildayjs db:seed --dry-run
`
  );

program
  .command("db:seed:status")
  .description("Show status of seed files")
  .action(async () => {
    try {
      const knex = knexManager.getInstance();
      const seeds = await knex.seed.list();

      log.info("\nSeed Files Status:");
      if (seeds.length === 0) {
        log.info("No seed files found");
      } else {
        seeds.forEach((file) => {
          log.info(`- ${path.basename(file)}`);
        });
        log.info(`\nTotal seed files: ${seeds.length}`);
      }
    } catch (error) {
      log.error("Failed to get seed status:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:seed:reset")
  .description("Delete all data and rerun all seeds")
  .option("--force", "Skip confirmation prompt")
  .action(async (options) => {
    try {
      if (!options.force) {
        log.warn("\nWARNING: This will delete all data in the seeded tables!");
        log.warn("Use --force to skip this warning\n");
        process.exit(0);
      }

      const knex = knexManager.getInstance();
      const seeds = await knex.seed.list();

      // Run all seeds
      await knex.seed.run();
      log.success(`Reset and ran ${seeds.length} seed files`);
    } catch (error) {
      log.error("Seed reset failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

// After the existing generate:migration command (around line 450)
program
  .command("generate:migration:with-seed <name> [columns...]")
  .description("Generate a new migration file with seed data")
  .option("-t, --table <name>", "Table name for the migration")
  .option("-d, --data <json>", "Seed data as JSON string")
  .option("-s, --soft-deletes", "Add soft deletes column")
  .option("--timestamps", "Add timestamp columns", true)
  .action(async (name, columnArgs, options) => {
    try {
      if (!name) {
        errors.migrationNameRequired();
        process.exit(1);
      }

      // Parse columns from arguments (Rails style)
      const columns = columnArgs || [];
      const seedData = options.data ? JSON.parse(options.data) : [];

      const result = await createTableWithSeed(
        name,
        columns, // Pass columns directly
        seedData, // Pass parsed seed data
        {
          softDeletes: options.softDeletes,
          timestamps: options.timestamps,
        }
      );

      if (result.migration && result.seed) {
        log.success(`Created migration file: ${result.migration.fileName}`);
        log.success(`Created seed file: ${result.seed.fileName}`);
      }
    } catch (error) {
      log.error("Failed to create migration with seed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  })
  .addHelpText(
    "after",
    `
Examples:
  # Create table with integrated seed data
  $ wildayjs generate:migration:with-seed CreateProfiles \\
    user_id:integer:references:required \\
    avatar_url:string \\
    bio:text \\
    --data='[
      {
        "user_id": 3,
        "avatar_url": "https://example.com/avatars/john.jpg",
        "bio": "Software developer"
      }
    ]'

  # With soft deletes and data from file
  $ wildayjs generate:migration:with-seed CreateProducts \\
    name:string:required \\
    price:decimal:required \\
    description:text \\
    --soft-deletes \\
    --data="$(cat seeds/products_data.json)"
`
  );

program
  .command("generate:migration:has-one-with-seed <name> [columns...]")
  .description("Generate a has-one relationship migration with seed data")
  .option("-d, --data <json>", "Seed data as JSON string")
  .option("-f, --data-file <path>", "Path to JSON seed data file")
  .option("-s, --soft-deletes", "Add soft deletes column")
  .option("--timestamps", "Add timestamp columns", true)
  .action(async (name, columnArgs, options) => {
    try {
      if (!name) {
        errors.migrationNameRequired();
        process.exit(1);
      }

      // Validate the name format
      if (!name.match(/^CreateHasOne\w+For\w+$/)) {
        log.error(
          "Invalid name format. Must be in format: CreateHasOneXForY (e.g., CreateHasOneProfileForUser)"
        );
        process.exit(1);
      }

      // Parse columns from arguments
      const columns = columnArgs || [];

      // Handle seed data from file or inline JSON
      let seedData = [];
      if (options.dataFile) {
        try {
          const filePath = path.resolve(process.cwd(), options.dataFile);
          const fileContent = await fs.readFile(filePath, "utf8");
          seedData = JSON.parse(fileContent);
        } catch (error) {
          log.error(`Failed to read data file: ${error.message}`);
          process.exit(1);
        }
      } else if (options.data) {
        try {
          seedData = JSON.parse(options.data);
        } catch (error) {
          log.error(`Invalid JSON data: ${error.message}`);
          process.exit(1);
        }
      }

      const result = await createHasOneWithSeed(name, columns, seedData, {
        softDeletes: options.softDeletes,
        timestamps: options.timestamps,
      });

      if (result.migration && result.seed) {
        log.success(`Created migration file: ${result.migration.fileName}`);
        log.success(`Created seed file: ${result.seed.fileName}`);
      }
    } catch (error) {
      log.error("Failed to create has-one migration with seed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  })
  .addHelpText(
    "after",
    `
Examples:
  # Create has-one profile for user with inline seed data
  $ wildayjs generate:migration:has-one-with-seed CreateHasOneProfileForUser \\
    avatar_url:string \\
    bio:text \\
    location:string \\
    website:string \\
    birth_date:date \\
    phone:string \\
    --data='[
      {
        "user_id": 1,
        "avatar_url": "https://example.com/avatar1.jpg",
        "bio": "Test bio",
        "location": "San Francisco",
        "website": "https://example.com",
        "birth_date": "1990-01-01",
        "phone": "+1234567890"
      }
    ]'

  # Create has-one profile using seed data from file
  $ wildayjs generate:migration:has-one-with-seed CreateHasOneProfileForUser \\
    avatar_url:string \\
    bio:text \\
    location:string \\
    website:string \\
    birth_date:date \\
    phone:string \\
    --data-file db/seeds/data/profiles.json

  # With soft deletes
  $ wildayjs generate:migration:has-one-with-seed CreateHasOneAddressForUser \\
    street:string \\
    city:string \\
    state:string \\
    postal_code:string \\
    --soft-deletes \\
    --data-file db/seeds/data/addresses.json
`
  );

program
  .command("generate:migration:add-column-with-seed <name> [columns...]")
  .description(
    "Generate a migration to add columns to an existing table with seed data"
  )
  .option("-d, --data <json>", "Seed data as JSON string")
  .option("-f, --data-file <path>", "Path to seed data JSON file")
  .option("-r, --run", "Run the migration and seed immediately after creation")
  .action(async (name, columns, options) => {
    try {
      const seedData = options.dataFile
        ? JSON.parse(await fs.readFile(options.dataFile, "utf8"))
        : options.data
        ? JSON.parse(options.data)
        : [];

      const result = await addColumnWithSeed(name, columns, seedData, {
        run: options.run,
      });

      if (result.migration && result.seed) {
        log.success(`Created migration file: ${result.migration.fileName}`);
        log.success(`Created seed file: ${result.seed.fileName}`);
      }

      if (options.run) {
        await runSeeds({ migration: true });
      }
    } catch (error) {
      log.error(
        "Failed to create add-column migration with seed:",
        error.message
      );
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  })
  .addHelpText(
    "after",
    `
Examples:
  # Add a single column with seed data
  $ wildayjs generate:migration:add-column-with-seed AddPhoneToUsers \\
    phone:string:required \\
    --data='[
      {"id": 1, "phone": "+1234567890"},
      {"id": 2, "phone": "+0987654321"}
    ]'

  # Add multiple columns with seed data from file
  $ wildayjs generate:migration:add-column-with-seed AddDetailsToUsers \\
    nickname:string:required \\
    bio:text \\
    --data-file db/seeds/user_details.json

  # Add columns and run migration immediately
  $ wildayjs generate:migration:add-column-with-seed AddProfileToUsers \\
    avatar_url:string \\
    bio:text \\
    --data='[
      {"id": 1, "avatar_url": "https://example.com/avatar1.jpg", "bio": "Hello"}
    ]' \\
    --run
`
  );

program
  .command("console")
  .description("Start WildayJS console")
  .action(() => startConsole());

// Help command
program
  .command("help")
  .description("Display help information")
  .action(() => showHelp());

program.parse(process.argv);

// Show help if no arguments provided
if (!process.argv.slice(2).length) {
  program.outputHelp();
}
