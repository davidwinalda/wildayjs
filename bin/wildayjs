#!/usr/bin/env node
const { showHelp, errors } = require("../lib/utils/chalkUtils");
const ModelGenerator = require("../lib/models/modelGenerator");
const ControllerGenerator = require("../lib/controllers/controllerGenerator");

const listDatabases = require("../lib/database/lists");
const {
  initDatabase,
  switchDatabase,
  DATABASE_TYPES,
} = require("../lib/database/init");
const dbStatus = require("../lib/database/status");
const checkDatabase = require("../lib/database/check");

const { startConsole, newApp } = require("../index");
const { program } = require("commander");
const path = require("path");

// Add Knex migration system
const {
  KnexMigrationSystem,
  COLUMN_TYPES,
  createMigration,
  runMigrations,
  rollbackMigrations,
  getMigrationStatus,
  listMigrations,
  runSingleMigration,
  rollbackSingleMigration,
  redoMigration,
  getCurrentVersion,
  resetMigrations,
  MigrationGenerator,
} = require("../lib/knex-migrations");
const { log } = require("../lib/knex-migrations/utils/logger");
const knexManager = require("../lib/knex-migrations/knexManager");

// Read version from package.json
const packageJson = require(path.join(__dirname, "..", "package.json"));

program
  .version(packageJson.version)
  .description("WildayJS - A Full-Stack JavaScript Web Framework");

// New app command
program
  .command("new <app-name>")
  .description("Create a new WildayJS application")
  .action((appName) => {
    if (!appName) {
      errors.missingArgument("app name");
      process.exit(1);
    }
    newApp(appName);
  });

// Database commands
program
  .command("db:init")
  .description("Initialize multi-database configuration")
  .option(
    "-t, --type <type>",
    `Set active database type (${DATABASE_TYPES.join("|")})`,
    "sqlite"
  )
  .option("-f, --force", "Force overwrite existing configuration", false)
  .action((options) => {
    const { type, force } = options;

    if (!DATABASE_TYPES.includes(type)) {
      console.error(`Error: Invalid database type '${type}'`);
      console.log(`Supported types: ${DATABASE_TYPES.join(", ")}`);
      process.exit(1);
    }

    console.log("\nInitializing multi-database configuration with options:", {
      activeType: type,
      force,
    });

    initDatabase({ type, force }).catch((error) => {
      console.error("Database initialization failed:", error.message);
      process.exit(1);
    });
  });

program
  .command("db:switch")
  .description("Switch active database")
  .argument(
    "<type>",
    `Database type to switch to (${DATABASE_TYPES.join("|")})`
  )
  .action((newType) => {
    if (!DATABASE_TYPES.includes(newType)) {
      console.error(`Error: Invalid database type '${newType}'`);
      console.log(`Supported types: ${DATABASE_TYPES.join(", ")}`);
      process.exit(1);
    }

    console.log(`\nSwitching active database to: ${newType}`);

    switchDatabase(newType)
      .then(() => {
        console.log(`Successfully switched to ${newType} database`);
      })
      .catch((error) => {
        console.error("Failed to switch database:", error.message);
        process.exit(1);
      });
  });

program
  .command("db:status:old")
  .description("Show database migration status and configuration")
  .option(
    "-t, --type <type>",
    `Check specific database type (${DATABASE_TYPES.join("|")})`,
    null
  )
  .action((options) => {
    if (options.type && !DATABASE_TYPES.includes(options.type)) {
      console.error(`Error: Invalid database type '${options.type}'`);
      console.log(`Supported types: ${DATABASE_TYPES.join(", ")}`);
      process.exit(1);
    }
    dbStatus(options.type);
  });

program
  .command("db:check")
  .description("Check database connection and structure")
  .option(
    "-t, --type <type>",
    `Check specific database type (${DATABASE_TYPES.join("|")})`,
    null
  )
  .action((options) => {
    if (options.type && !DATABASE_TYPES.includes(options.type)) {
      console.error(`Error: Invalid database type '${options.type}'`);
      console.log(`Supported types: ${DATABASE_TYPES.join(", ")}`);
      process.exit(1);
    }
    checkDatabase(options.type);
  });

program
  .command("db:list:mydb")
  .description("List all configured databases and their status")
  .action(listDatabases);

// Generate commands
program
  .command("generate:controller <name> [actions...]")
  .description("Generate a new controller")
  .option("--api", "Generate an API controller")
  .option("--skip-views", "Skip generating views")
  .option("--skip-routes", "Skip adding routes")
  .action((name, actions, options) => {
    if (!name) {
      console.error("Controller name is required");
      process.exit(1);
    }
    const generator = new ControllerGenerator(name, actions, options);
    generator.generate();
  });

program
  .command("generate:model <name> [attributes...]")
  .description("Generate a new model")
  .action((name, attributes) => {
    if (!name) {
      console.error("Model name is required");
      process.exit(1);
    }
    const generator = new ModelGenerator(name, attributes);
    generator.generate();
  });

// Update the migration generation command
program
  .command("generate:migration <name> [columns...]")
  .description("Generate a new migration file")
  .option("-c, --columns <items>", "Column definitions (comma-separated)")
  .option("-t, --table <name>", "Table name for the migration")
  .option("-s, --soft-deletes", "Add soft deletes column")
  .option("--timestamps", "Add timestamp columns", true)
  .option("--from <column>", "Original column name for rename migrations")
  .option("--to <column>", "New column name for rename migrations")
  .action(async (name, columnArgs, options) => {
    try {
      if (!name) {
        errors.migrationNameRequired();
        process.exit(1);
      }

      // Parse columns from both arguments and options
      let columns = [];

      // Handle direct column arguments (Rails style)
      if (columnArgs && columnArgs.length > 0) {
        columns = columnArgs.map((col) =>
          MigrationGenerator.parseColumnString(col)
        );
      }
      // Handle --columns option (legacy style)
      else if (options.columns) {
        columns = options.columns
          .split(",")
          .map((col) => MigrationGenerator.parseColumnString(col.trim()));
      }

      const migrationOptions = {
        tableName: options.table,
        softDeletes: options.softDeletes,
        timestamps: options.timestamps,
      };

      const filepath = await createMigration(name, columns, migrationOptions);
      log.success(`Created migration: ${filepath}`);
    } catch (error) {
      log.error("Failed to create migration:", error.message);
      process.exit(1);
    }
  })
  .addHelpText(
    "after",
    `
Examples:
  # Create table
  $ wildayjs generate:migration CreateUsers name:string:required email:string:unique

  # Add column
  $ wildayjs generate:migration AddPhoneToUsers phone:string:index

  # Remove column
  $ wildayjs generate:migration RemovePhoneFromUsers

  # Rename column
  $ wildayjs generate:migration RenamePhoneToMobileInUsers

  # Change column
  $ wildayjs generate:migration ChangeEmailInUsers -c "email:string:required:unique"

  # Drop table
  $ wildayjs generate:migration DropUsers

  # Legacy style (still supported)
  $ wildayjs generate:migration create_users -c "name:string:required,email:string:unique" -s
  `
  );

// Remove the old migration commands and keep only the new ones
program
  .command("db:migrate")
  .description("Run pending migrations")
  .option("--dry-run", "Show which migrations would run without executing them")
  .action(async (options) => {
    try {
      if (options.dryRun) {
        const status = await getMigrationStatus();
        if (status.pending.length === 0) {
          log.info("No pending migrations");
          return;
        }
        log.info("Pending migrations:");
        status.pending.forEach((migration) => log.info(`- ${migration}`));
        return;
      }

      const result = await runMigrations();
      log.success(`Executed ${result.executed} migrations`);
    } catch (error) {
      log.error("Migration failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:rollback")
  .description("Rollback migrations")
  .option("-a, --all", "Rollback all migrations")
  .option("-s, --steps <number>", "Number of migrations to rollback", "1")
  .action(async (options) => {
    try {
      const result = await rollbackMigrations({
        all: options.all,
        steps: parseInt(options.steps, 10),
      });
      log.success(`Rolled back ${result.rolledBack} migrations`);
    } catch (error) {
      log.error("Rollback failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:up [name]")
  .description("Run a specific migration")
  .action(async (name) => {
    try {
      await runSingleMigration(name);
      log.success(`Successfully ran migration: ${name}`);
    } catch (error) {
      log.error("Migration failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:down [name]")
  .description("Rollback a specific migration")
  .action(async (name) => {
    try {
      await rollbackSingleMigration(name);
      log.success(`Successfully rolled back migration: ${name}`);
    } catch (error) {
      log.error("Rollback failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:redo [name]")
  .description("Redo migrations (rollback and migrate again)")
  .action(async (name) => {
    try {
      await redoMigration(name);
    } catch (error) {
      log.error("Redo failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:migration:status")
  .description("Show migration status")
  .action(async () => {
    try {
      const status = await getMigrationStatus();
      log.info("\nMigration Status:");
      log.info(`- Completed: ${status.completed.length}`);
      log.info(`- Pending: ${status.pending.length}`);
      log.info(`- Total: ${status.total}`);

      if (status.pending.length > 0) {
        log.info("\nPending Migrations:");
        status.pending.forEach((migration) => log.info(`- ${migration}`));
      }
    } catch (error) {
      log.error("Failed to get migration status:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:reset")
  .description("Reset database by running all migrations down and up")
  .option("--force", "Skip confirmation prompt")
  .action(async (options) => {
    try {
      await resetMigrations(options);
    } catch (error) {
      log.error("Reset failed:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:status")
  .description("Show migration status")
  .action(async () => {
    try {
      await getMigrationStatus();
    } catch (error) {
      log.error("Failed to get migration status:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:list")
  .description("List all migrations")
  .action(async () => {
    try {
      await listMigrations();
    } catch (error) {
      log.error("Failed to list migrations:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("db:version")
  .description("Show current migration version")
  .action(async () => {
    try {
      await getCurrentVersion();
    } catch (error) {
      log.error("Failed to get version:", error.message);
      process.exit(1);
    } finally {
      await knexManager.closeConnection();
      process.exit(0);
    }
  });

program
  .command("console")
  .description("Start WildayJS console")
  .action(() => startConsole());

// Help command
program
  .command("help")
  .description("Display help information")
  .action(() => showHelp());

program.parse(process.argv);

// Show help if no arguments provided
if (!process.argv.slice(2).length) {
  program.outputHelp();
}
